{
  "name": "Toss Stock Monitor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup uvicorn app:app --host 0.0.0.0 --port 8000 > /tmp/stock-monitor.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Stock Monitor",
      "onAutoForward": "openBrowser"
    }
  }
}
